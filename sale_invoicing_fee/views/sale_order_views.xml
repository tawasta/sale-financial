<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_form_payment_method" model="ir.ui.view">
        <field name="name">sale.order.form.payment.method</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <field name="preferred_payment_method_line_id" position="after">
                <field
                    string="Selected Payment Method (Webshop)"
                    name="payment_method_id"
                    options="{'no_open': True, 'no_create': True}"
                />
            </field>
        </field>
    </record>
</odoo>
